---
import FlipCard from "./FlipCard.astro";

const recentWork = {
  title: "From narrative to action: A hierarchical cognitive large language model agent framework for interpretable and adaptive human mobility behavior generation",
  journal: "Engineering Applications of Artificial Intelligence",
  year: 2026,
  volume: "184",
  article: "116203",
  doi: "10.1016/j.engappai.2026.116203",
  href: "https://www.sciencedirect.com/science/article/pii/S0952197626024875",
};
---

<FlipCard
  label="Signature"
  frontLabel="Recent Work"
  backLabel="Signature"
  toggleColor="text-teal-300"
  colSpan="md:col-span-2 lg:col-span-3"
  rowSpan="md:row-span-2"
  padding="p-0"
  color="bg-[#020807]"
  borderColor="border-[#00e5d4]"
  class="h-[280px] md:h-[240px] lg:h-full"
>
  <div
    slot="front"
    data-ideas-swarm
    class="ideas-swarm"
    role="img"
    aria-label="Drifting particles gather into three signatures: JI CHUNHOU, februarysea, HUNK."
  >
    <canvas class="ideas-swarm-canvas" aria-hidden="true"></canvas>
    <div class="ideas-swarm-fallback" aria-hidden="true">JI CHUNHOU</div>
  </div>
  <div slot="back" class="recent-work">
    <h2>Recent Work</h2>
    <article class="recent-paper">
      <h3><a href={recentWork.href} target="_blank" rel="noopener noreferrer">{recentWork.title}</a></h3>
      <p class="paper-authors">Qiumeng Li, <strong>Chunhou Ji</strong>, Xinyue Liu</p>
      <p class="paper-meta">{recentWork.journal} · {recentWork.volume} ({recentWork.year}), {recentWork.article}</p>
    </article>
  </div>
  <a slot="footer-back" class="paper-doi" href={`https://doi.org/${recentWork.doi}`} target="_blank" rel="noopener noreferrer">DOI: {recentWork.doi}</a>
</FlipCard>

<script>
  type Particle = {
    x: number; y: number;
    baseX: number; baseY: number;
    phase: number; rate: number; radius: number;
    target: { x: number; y: number } | null;
  };
  const swarmControllers = new Map<HTMLElement, () => void>();
  const words = ["JI CHUNHOU", "februarysea", "HUNK"];
  const cycleDuration = 15;
  const ease = (value: number) => {
    const bounded = Math.max(0, Math.min(1, value));
    return bounded * bounded * (3 - 2 * bounded);
  };

  function initIdeasSwarms() {
    document.querySelectorAll<HTMLElement>("[data-ideas-swarm]").forEach((container) => {
      if (swarmControllers.has(container)) return;
      const canvas = container.querySelector<HTMLCanvasElement>("canvas");
      const context = canvas?.getContext("2d");
      const glyphCanvas = document.createElement("canvas");
      const glyphContext = glyphCanvas.getContext("2d", { willReadFrequently: true });
      if (!canvas || !context || !glyphContext) return;

      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const card = container.closest<HTMLElement>(".flip-card-container");
      const events = new AbortController();
      let width = 0, height = 0, elapsed = 0, lastTime = 0, wordIndex = 0;
      let frame: number | undefined;
      let inView = false, pageHidden = false, destroyed = false;
      const particles: Particle[] = [];

      function retargetWord() {
        if (!glyphContext || !width || !height) return;
        glyphCanvas.width = Math.ceil(width);
        glyphCanvas.height = Math.ceil(height);
        let fontSize = Math.min(100, height * 0.64);
        glyphContext.font = `700 ${fontSize}px Menlo, Monaco, Consolas, monospace`;
        fontSize *= Math.min(1, width * 0.82 / glyphContext.measureText(words[wordIndex]).width);
        glyphContext.font = `700 ${fontSize}px Menlo, Monaco, Consolas, monospace`;
        glyphContext.textAlign = "center";
        glyphContext.textBaseline = "middle";
        glyphContext.fillStyle = "white";
        glyphContext.fillText(words[wordIndex], width / 2, height * 0.58);

        const pixels = glyphContext.getImageData(0, 0, glyphCanvas.width, glyphCanvas.height);
        const candidates: { x: number; y: number }[] = [];
        const spacing = fontSize > 75 ? 3.2 : 2.5;
        for (let y = 0; y < height; y += spacing) {
          for (let x = 0; x < width; x += spacing) {
            const pixel = (Math.floor(y) * glyphCanvas.width + Math.floor(x)) * 4 + 3;
            if (pixels.data[pixel] > 160) candidates.push({ x, y });
          }
        }
        // Evenly sample the letters, then recruit nearby particles for quiet movement.
        const count = Math.min(560, candidates.length);
        const available = particles.slice();
        particles.forEach((particle) => { particle.target = null; });
        for (let index = 0; index < count; index++) {
          const target = candidates[Math.floor(index * candidates.length / count)];
          let nearest = 0, distance = Infinity;
          available.forEach((particle, candidateIndex) => {
            const squared = (particle.x - target.x) ** 2 + (particle.y - target.y) ** 2;
            if (squared < distance) {
              nearest = candidateIndex;
              distance = squared;
            }
          });
          available[nearest].target = target;
          available.splice(nearest, 1);
        }
      }

      function paint(delta: number) {
        if (!context || !width || !height) return;
        const phase = elapsed % cycleDuration;
        const formation = Math.min(ease((phase - 1) / 3), 1 - ease((phase - 7) / 5));
        const following = delta > 0 ? 1 - Math.exp(-delta * 5) : 0;
        context.clearRect(0, 0, width, height);
        particles.forEach((particle, index) => {
          const driftX = particle.baseX * width
            + Math.sin(elapsed * particle.rate + particle.phase) * Math.min(28, width * 0.04);
          const driftY = particle.baseY * height
            + Math.cos(elapsed * particle.rate * 0.8 + particle.phase) * Math.min(18, height * 0.09);
          const gathering = particle.target ? formation : 0;
          const desiredX = driftX * (1 - gathering) + (particle.target?.x ?? driftX) * gathering;
          const desiredY = driftY * (1 - gathering) + (particle.target?.y ?? driftY) * gathering;
          particle.x += (desiredX - particle.x) * following;
          particle.y += (desiredY - particle.y) * following;
          const shimmer = 0.5 + Math.sin(elapsed * 0.55 + particle.phase) * 0.15;
          const opacity = particle.target
            ? shimmer * (1 - formation) + 0.92 * formation
            : shimmer * (1 - formation * 0.58);
          context.fillStyle = index % 7 === 0
            ? `rgba(176,255,241,${opacity})` : `rgba(0,229,212,${opacity})`;
          context.beginPath();
          context.arc(particle.x, particle.y, particle.radius + gathering * 0.16, 0, Math.PI * 2);
          context.fill();
        });
      }

      function resize() {
        if (!canvas || !context) return;
        // Layout sizes stay stable while the parent is rotated in 3D.
        const nextWidth = container.clientWidth, nextHeight = container.clientHeight;
        if (!nextWidth || !nextHeight || (width === nextWidth && height === nextHeight)) return;
        particles.forEach((particle) => {
          particle.x *= nextWidth / width;
          particle.y *= nextHeight / height;
        });
        width = nextWidth;
        height = nextHeight;
        const dpr = Math.min(window.devicePixelRatio || 1, 2);
        canvas.width = Math.round(width * dpr);
        canvas.height = Math.round(height * dpr);
        context.setTransform(dpr, 0, 0, dpr, 0, 0);
        if (!particles.length) {
          for (let index = 0; index < 660; index++) {
            const baseX = 0.015 + Math.random() * 0.97, baseY = 0.15 + Math.random() * 0.76;
            particles.push({
              x: baseX * width, y: baseY * height, baseX, baseY,
              phase: Math.random() * Math.PI * 2, rate: 0.18 + Math.random() * 0.12,
              radius: 0.65 + Math.random() * 0.45, target: null,
            });
          }
        }
        retargetWord();
        paint(0);
        refresh();
      }

      function pause() {
        if (frame !== undefined) cancelAnimationFrame(frame);
        frame = undefined;
        lastTime = 0;
      }
      function render(timestamp: number) {
        frame = undefined;
        const delta = lastTime ? Math.min((timestamp - lastTime) / 1000, 0.05) : 0;
        lastTime = timestamp;
        elapsed += delta;
        const nextWord = Math.floor(elapsed / cycleDuration) % words.length;
        if (nextWord !== wordIndex) {
          wordIndex = nextWord;
          retargetWord();
        }
        paint(delta);
        frame = requestAnimationFrame(render);
      }
      function refresh() {
        container.dataset.swarmActive = String(!reducedMotion.matches);
        const frontVisible = !card || card.dataset.manualFace !== "back";
        if (destroyed || !inView || !frontVisible || !width || !height || document.hidden || pageHidden || reducedMotion.matches) {
          pause();
        } else if (frame === undefined) frame = requestAnimationFrame(render);
      }

      const visibility = new IntersectionObserver(([entry]) => {
        inView = entry.isIntersecting;
        refresh();
      });
      const sizing = new ResizeObserver(resize);
      const facing = new MutationObserver(refresh);
      visibility.observe(container);
      sizing.observe(container);
      if (card) facing.observe(card, { attributes: true, attributeFilter: ["data-manual-face"] });
      document.addEventListener("visibilitychange", refresh, { signal: events.signal });
      reducedMotion.addEventListener("change", refresh, { signal: events.signal });
      window.addEventListener("pagehide", () => {
        pageHidden = true;
        pause();
      }, { signal: events.signal });
      window.addEventListener("pageshow", () => {
        pageHidden = false;
        refresh();
      }, { signal: events.signal });
      swarmControllers.set(container, () => {
        destroyed = true;
        pause();
        events.abort();
        visibility.disconnect();
        sizing.disconnect();
        facing.disconnect();
        delete container.dataset.swarmActive;
      });
      resize();
    });
  }
  initIdeasSwarms();
  document.addEventListener("astro:page-load", initIdeasSwarms);
  document.addEventListener("astro:before-swap", () => {
    swarmControllers.forEach((destroy) => destroy());
    swarmControllers.clear();
  });
</script>

<style>
  .ideas-swarm {
    position: relative;
    width: 100%;
    height: 100%;
    min-width: 0;
    overflow: hidden;
    background: radial-gradient(ellipse at 50% 42%, #08201e 0%, #040b0b 48%, #020404 100%);
  }
  .ideas-swarm-canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
  }
  .ideas-swarm-fallback {
    position: absolute;
    inset: 16% 0 0;
    display: grid;
    place-items: center;
    color: #63cfbd;
    font: 500 clamp(30px, 5vw, 56px) / 1 Menlo, Monaco, Consolas, monospace;
    letter-spacing: 0.14em;
  }
  .recent-work {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 6px;
    height: 100%;
    min-width: 0;
    padding: 8px 18px 0;
    overflow: auto;
    font-family: sans-serif;
  }
  .recent-work h2 { margin: 0; color: #a4d4cb; font-size: 11px; font-weight: 500; line-height: 13px; }
  .recent-paper { display: grid; gap: 4px; min-width: 0; }
  .recent-paper h3 { margin: 0; color: #e5f2ee; font-size: 14px; line-height: 18px; font-weight: 500; }
  .recent-paper a { color: inherit; text-decoration: none; }
  .recent-paper a:hover { color: #5ce4ce; }
  .recent-paper a:focus-visible, .paper-doi:focus-visible { outline: 1px solid #5ce4ce; outline-offset: 3px; }
  .paper-authors { margin: 0; color: #94b5ab; font-size: 10px; line-height: 14px; }
  .paper-authors strong { color: #d4e6df; font-weight: 500; }
  .paper-meta { margin: 0; color: #709f94; font-size: 10px; line-height: 13px; }
  .paper-doi { color: #709f94; font-size: 9px; overflow-wrap: anywhere; }
  .paper-doi:hover { color: #5ce4ce; }
  [data-swarm-active="true"] .ideas-swarm-canvas { opacity: 1; }
  [data-swarm-active="true"] .ideas-swarm-fallback { opacity: 0; }
  @media (prefers-reduced-motion: reduce) {
    .ideas-swarm-canvas { display: none; }
    .ideas-swarm-fallback { opacity: 1 !important; }
  }
</style>
