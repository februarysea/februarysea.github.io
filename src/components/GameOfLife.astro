---
const glider = [[1, 0], [2, 1], [0, 2], [1, 2], [2, 2]];
const blinker = [[0, 0], [1, 0], [2, 0]];
const seeds = [
  { x: 35, y: 35, cells: glider }, { x: 115, y: 80, cells: glider },
  { x: 225, y: 45, cells: glider }, { x: 320, y: 105, cells: glider },
  { x: 60, y: 115, cells: blinker }, { x: 180, y: 110, cells: blinker },
  { x: 275, y: 90, cells: blinker }, { x: 345, y: 30, cells: blinker },
];
---

<div
  class="game-of-life"
  data-game-of-life
  role="img"
  aria-label="Conway's Game of Life. Turquoise cells evolve using simple neighbor rules."
>
  <svg class="life-fallback" viewBox="0 0 400 160" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
    {seeds.flatMap((seed) => seed.cells.map(([x, y]) => (
      <rect x={seed.x + x * 5} y={seed.y + y * 5} width="3" height="3" fill="#00e5d4" />
    )))}
  </svg>
  <canvas class="life-canvas" aria-hidden="true"></canvas>
</div>

<script>
  const lifeControllers = new Map<HTMLElement, () => void>();
  const cellSize = 5;
  const interval = 1000 / 15;

  function initGameOfLife() {
    document.querySelectorAll<HTMLElement>("[data-game-of-life]").forEach((container) => {
      if (lifeControllers.has(container)) return;
      const canvas = container.querySelector<HTMLCanvasElement>("canvas");
      const context = canvas?.getContext("2d");
      if (!canvas || !context) return;

      const card = container.closest<HTMLElement>(".flip-card-container");
      const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
      const events = new AbortController();
      let width = 0, height = 0, pixelRatio = 1, cols = 0, rows = 0;
      let grid = new Uint8Array(0), nextGrid = new Uint8Array(0);
      let generation = 0, repeatedGenerations = 0;
      let recentStates: number[] = [];
      let frame: number | undefined;
      let lastTime = 0;
      let inView = false, pageHidden = false, destroyed = false;

      function seedGrid() {
        grid = new Uint8Array(cols * rows);
        nextGrid = new Uint8Array(cols * rows);
        for (let index = 0; index < grid.length; index++) {
          grid[index] = Math.random() > 0.82 ? 1 : 0;
        }
        generation = 0;
        repeatedGenerations = 0;
        recentStates = [];
      }

      function advance() {
        let population = 0, signature = 2166136261;
        for (let y = 0; y < rows; y++) {
          for (let x = 0; x < cols; x++) {
            let neighbors = 0;
            for (let dy = -1; dy <= 1; dy++) {
              for (let dx = -1; dx <= 1; dx++) {
                if (!dx && !dy) continue;
                neighbors += grid[((y + dy + rows) % rows) * cols + ((x + dx + cols) % cols)];
              }
            }
            const index = y * cols + x;
            const alive = neighbors === 3 || (grid[index] === 1 && neighbors === 2) ? 1 : 0;
            nextGrid[index] = alive;
            population += alive;
            signature = Math.imul(signature ^ alive, 16777619) >>> 0;
          }
        }
        [grid, nextGrid] = [nextGrid, grid];
        generation++;
        // Check actual arrangements, including short oscillators, not just population.
        repeatedGenerations = recentStates.includes(signature) ? repeatedGenerations + 1 : 0;
        recentStates.push(signature);
        if (recentStates.length > 8) recentStates.shift();
        if (population < Math.min(15, grid.length * 0.03) || repeatedGenerations > 50 || generation > 1000) {
          seedGrid();
        }
      }

      function paint() {
        if (!context || !width || !height) return;
        context.clearRect(0, 0, width, height);
        const offsetX = (width - cols * cellSize) / 2;
        const offsetY = (height - rows * cellSize) / 2;
        context.strokeStyle = "rgba(255,255,255,0.02)";
        context.lineWidth = 1;
        context.beginPath();
        for (let x = 0; x <= cols; x++) {
          context.moveTo(offsetX + x * cellSize, 0);
          context.lineTo(offsetX + x * cellSize, height);
        }
        for (let y = 0; y <= rows; y++) {
          context.moveTo(0, offsetY + y * cellSize);
          context.lineTo(width, offsetY + y * cellSize);
        }
        context.stroke();
        context.shadowColor = "#00e5d4";
        for (let y = 0; y < rows; y++) {
          for (let x = 0; x < cols; x++) {
            if (!grid[y * cols + x]) continue;
            const bright = (x + y + generation) % 7 === 0;
            context.shadowBlur = bright ? 8 : 2;
            context.fillStyle = bright ? "#00fff0" : "#00b8aa";
            context.fillRect(offsetX + x * cellSize + 1, offsetY + y * cellSize + 1, cellSize - 2, cellSize - 2);
          }
        }
        context.shadowBlur = 0;
        container.dataset.lifeGeneration = String(generation);
      }

      function pause() {
        if (frame !== undefined) cancelAnimationFrame(frame);
        frame = undefined;
        lastTime = 0;
        container.dataset.lifeRunning = "false";
      }

      function render(timestamp: number) {
        frame = undefined;
        if (destroyed) return;
        if (!lastTime) lastTime = timestamp;
        if (timestamp - lastTime >= interval) {
          lastTime = timestamp - ((timestamp - lastTime) % interval);
          advance();
          paint();
        }
        frame = requestAnimationFrame(render);
      }

      function refresh() {
        const frontVisible = !card || card.dataset.manualFace !== "back";
        if (destroyed || !inView || !frontVisible || !width || !height || document.hidden || pageHidden || reducedMotion.matches) {
          pause();
        } else if (frame === undefined) {
          container.dataset.lifeRunning = "true";
          frame = requestAnimationFrame(render);
        }
      }

      function resize() {
        if (!canvas || !context) return;
        // A CSS rotation changes the visual bounds, not the simulation's layout.
        const nextWidth = container.clientWidth, nextHeight = container.clientHeight;
        const nextRatio = Math.min(window.devicePixelRatio || 1, 2);
        if (!nextWidth || !nextHeight || (width === nextWidth && height === nextHeight && pixelRatio === nextRatio)) return;
        width = nextWidth;
        height = nextHeight;
        pixelRatio = nextRatio;
        canvas.width = Math.round(width * pixelRatio);
        canvas.height = Math.round(height * pixelRatio);
        context.setTransform(pixelRatio, 0, 0, pixelRatio, 0, 0);
        const nextCols = Math.max(1, Math.floor(width / cellSize));
        const nextRows = Math.max(1, Math.floor(height / cellSize));
        if (cols !== nextCols || rows !== nextRows) {
          cols = nextCols;
          rows = nextRows;
          seedGrid();
        }
        paint();
        container.dataset.lifeReady = "true";
        refresh();
      }

      const visibility = new IntersectionObserver(([entry]) => {
        inView = entry.isIntersecting;
        refresh();
      });
      const sizing = new ResizeObserver(resize);
      const facing = new MutationObserver(refresh);
      visibility.observe(container);
      sizing.observe(container);
      if (card) facing.observe(card, { attributes: true, attributeFilter: ["data-manual-face"] });
      document.addEventListener("visibilitychange", refresh, { signal: events.signal });
      reducedMotion.addEventListener("change", refresh, { signal: events.signal });
      window.addEventListener("pagehide", () => {
        pageHidden = true;
        pause();
      }, { signal: events.signal });
      window.addEventListener("pageshow", () => {
        pageHidden = false;
        refresh();
      }, { signal: events.signal });
      lifeControllers.set(container, () => {
        destroyed = true;
        pause();
        events.abort();
        visibility.disconnect();
        sizing.disconnect();
        facing.disconnect();
        delete container.dataset.lifeReady;
        delete container.dataset.lifeGeneration;
      });
      resize();
    });
  }

  initGameOfLife();
  document.addEventListener("astro:page-load", initGameOfLife);
  document.addEventListener("astro:before-swap", () => {
    lifeControllers.forEach((destroy) => destroy());
    lifeControllers.clear();
  });
</script>

<style>
  .game-of-life {
    position: relative;
    width: 100%;
    height: 100%;
    overflow: hidden;
    background: #020303;
    box-shadow: inset 0 0 30px rgb(0 229 212 / 0.1);
  }
  .life-canvas, .life-fallback { position: absolute; inset: 0; width: 100%; height: 100%; }
  .life-canvas { opacity: 0; }
  .life-fallback {
    background-image: linear-gradient(rgb(255 255 255 / 0.02) 1px, transparent 1px), linear-gradient(90deg, rgb(255 255 255 / 0.02) 1px, transparent 1px);
    background-size: 5px 5px;
  }
  [data-life-ready="true"] .life-canvas { opacity: 1; }
  [data-life-ready="true"] .life-fallback { opacity: 0; }
</style>
