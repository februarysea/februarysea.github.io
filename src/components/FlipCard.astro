---
interface Props {
  colSpan?: string;
  rowSpan?: string;
  href?: string;
  padding?: string;
  color?: string;
  borderColor?: string;
  class?: string;
  label?: string;
  frontLabel?: string;
  backLabel?: string;
  toggleColor?: string;
  compact?: boolean;
  hideFrontToggle?: boolean;
}

const {
  colSpan, rowSpan, padding = "p-6", color = "bg-darkslate-500",
  borderColor = "border-darkslate-100", class: className,
  label = "Card", frontLabel = "Details", backLabel = "Overview",
  toggleColor = "text-gray-400", compact = false, hideFrontToggle = false,
} = Astro.props;
---

<!-- Grid stretch fills desktop rows; a global h-full would override mobile heights. -->
<div data-manual-face="front" class:list={[
  `flip-card-container group perspective-1000 w-full ${colSpan || "md:col-span-1"} ${rowSpan || "md:row-span-1"} ${className || "min-h-[180px] lg:min-h-0"}`,
  { "flip-card-compact": compact, "flip-card-edge": padding === "p-0" },
]}>
  <div class="flip-card-inner relative w-full h-full transition-transform duration-700 transform-style-3d">
    <div data-flip-side="front" aria-hidden="false" class={`flip-card-front absolute inset-0 backface-hidden ${color} shadow-lg rounded-lg ${padding} border ${borderColor} flex flex-col overflow-hidden`}>
      <div class="flip-card-content"><slot name="front" /></div>
      {(!hideFrontToggle || Astro.slots.has("footer-front")) && (
        <div class="flip-card-footer">
          <div class="flip-card-footer-note"><slot name="footer-front" /></div>
          {!hideFrontToggle && <button type="button" data-flip-to="back" class={`flip-card-toggle ${toggleColor}`} aria-label={`${label}: ${frontLabel}`} hidden>
            {frontLabel}<span aria-hidden="true">↻</span>
          </button>}
        </div>
      )}
      {hideFrontToggle && <button type="button" data-flip-to="back" class="flip-card-surface-toggle" aria-label={`${label}: ${frontLabel}`} hidden></button>}
    </div>

    <div data-flip-side="back" aria-hidden="true" inert class={`flip-card-back absolute inset-0 backface-hidden rotate-y-180 ${color} shadow-lg rounded-lg ${padding} border ${borderColor} flex flex-col overflow-hidden`}>
      <div class="flip-card-content"><slot name="back" /></div>
      <div class="flip-card-footer">
        <div class="flip-card-footer-note"><slot name="footer-back" /></div>
        <button type="button" data-flip-to="front" class={`flip-card-toggle ${toggleColor}`} aria-label={`${label}: ${backLabel}`} hidden>
          {backLabel}<span aria-hidden="true">↻</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  type CardFace = "front" | "back";
  const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
  const controllers = new Map<HTMLElement, { refresh: () => void; destroy: () => void }>();
  let dialogObserver: MutationObserver | undefined;
  let pageHidden = false;

  function refreshFlipCards() {
    controllers.forEach(({ refresh }) => refresh());
  }

  function initFlipCards() {
    document.querySelectorAll<HTMLElement>(".flip-card-container").forEach((container, index) => {
      if (controllers.has(container)) return;
      const inner = container.querySelector<HTMLElement>(".flip-card-inner");
      const front = container.querySelector<HTMLElement>('[data-flip-side="front"]');
      const back = container.querySelector<HTMLElement>('[data-flip-side="back"]');
      if (!inner || !front || !back) return;

      const events = new AbortController();
      let restingFace: CardFace = container.dataset.manualFace === "back" ? "back" : "front";
      let previewing = false;
      let hasPreviewed = false;
      let inView = false;
      let disposed = false;
      let timer: number | undefined;
      let interactionUntil = 0;
      let pointerInside = false;
      let hoverReturn: { face: CardFace; interactionUntil: number } | undefined;

      container.dataset.flipReady = "true";
      container.querySelectorAll<HTMLButtonElement>("[data-flip-to]").forEach((button) => {
        button.hidden = false;
      });

      const showFace = (face: CardFace, moveFocus = false) => {
        const shown = face === "front" ? front : back;
        const hidden = face === "front" ? back : front;
        shown.inert = false;
        shown.setAttribute("aria-hidden", "false");
        container.dataset.manualFace = face;
        inner.classList.toggle("flipped", face === "back");
        // Only an explicit flip moves focus; an idle preview never takes focus.
        if (moveFocus) {
          shown.querySelector<HTMLButtonElement>("[data-flip-to]")?.focus({ preventScroll: true });
        } else if (hidden.contains(document.activeElement)) {
          // A pointer click must not leave its old button focused on an inert face.
          (document.activeElement as HTMLElement | null)?.blur();
        }
        hidden.inert = true;
        hidden.setAttribute("aria-hidden", "true");
      };

      function clearTimer() {
        window.clearTimeout(timer);
        timer = undefined;
      }

      function canPreview() {
        const focused = document.activeElement;
        const readingWithKeyboard = focused instanceof HTMLElement && container.contains(focused)
          && (focused.matches(":focus-visible, input, textarea, select") || focused.isContentEditable);
        return !disposed && inView && !document.hidden && !pageHidden
          && !reducedMotion.matches && !readingWithKeyboard
          && !document.querySelector("dialog[open]");
      }

      function refresh() {
        if (!canPreview()) {
          clearTimer();
          return;
        }
        if (timer !== undefined) return;
        // Let the first staggered peek make the interaction discoverable, then settle.
        const idleDelay = previewing ? 3500 + Math.random() * 1500
          : hasPreviewed ? 8000 + Math.random() * 6000
            : 3000 + (index * 550) % 2600 + Math.random() * 400;
        const readingTime = interactionUntil - Date.now();
        const delay = readingTime > 0 ? readingTime : idleDelay;
        timer = window.setTimeout(() => {
          timer = undefined;
          if (!canPreview()) return;
          // The idle cycle has taken over; leaving later must not rewind it.
          hoverReturn = undefined;
          previewing = !previewing;
          hasPreviewed = true;
          showFace(previewing ? (restingFace === "front" ? "back" : "front") : restingFace);
          refresh();
        }, delay);
      }

      container.addEventListener("click", (event) => {
        if (!(event.target instanceof Element)) return;
        const button = event.target.closest<HTMLButtonElement>("[data-flip-to]");
        if (!button || button.closest(".flip-card-container") !== container) return;
        const face = button.dataset.flipTo;
        if (face !== "front" && face !== "back") return;
        clearTimer();
        hoverReturn = undefined;
        interactionUntil = Date.now() + 10000;
        restingFace = face;
        previewing = false;
        // Keyboard users continue from the matching control. Pointer users get
        // ten seconds to read before idle animation resumes, even while hovering.
        showFace(face, event.detail === 0);
        refresh();
      }, { signal: events.signal });

      const isWithinCard = (event: PointerEvent) => {
        const bounds = container.getBoundingClientRect();
        return event.clientX >= bounds.left && event.clientX <= bounds.right
          && event.clientY >= bounds.top && event.clientY <= bounds.bottom;
      };

      function leaveHover() {
        pointerInside = false;
        const previous = hoverReturn;
        hoverReturn = undefined;
        if (!previous) return;
        clearTimer();
        interactionUntil = previous.interactionUntil;
        // Never hide a face that acquired keyboard or editable-field focus.
        if (canPreview()) {
          previewing = previous.face !== restingFace;
          showFace(previous.face);
        }
        refresh();
      }

      container.addEventListener("pointerenter", (event) => {
        if (event.pointerType === "touch" || pointerInside || !isWithinCard(event)) return;
        pointerInside = true;
        if (!canPreview()) return;
        clearTimer();
        const visibleFace: CardFace = container.dataset.manualFace === "back" ? "back" : "front";
        hoverReturn = { face: visibleFace, interactionUntil };
        const nextFace = visibleFace === "front" ? "back" : "front";
        previewing = nextFace !== restingFace;
        hasPreviewed = true;
        interactionUntil = Date.now() + 10000;
        showFace(nextFace);
        refresh();
      }, { signal: events.signal });
      container.addEventListener("pointerleave", (event) => {
        // 3D faces can change hit-testing without the pointer leaving the card.
        if (event.pointerType !== "touch" && !isWithinCard(event)) leaveHover();
      }, { signal: events.signal });
      window.addEventListener("pointermove", (event) => {
        // Also catch a real exit after a transform-generated boundary event.
        if (pointerInside && event.pointerType !== "touch" && !isWithinCard(event)) leaveHover();
      }, { signal: events.signal });

      container.addEventListener("focusin", refresh, { signal: events.signal });
      container.addEventListener("focusout", () => queueMicrotask(refresh), { signal: events.signal });

      const visibility = new IntersectionObserver(([entry]) => {
        inView = entry.isIntersecting;
        refresh();
      });
      visibility.observe(container);

      controllers.set(container, {
        refresh,
        destroy: () => {
          disposed = true;
          clearTimer();
          events.abort();
          visibility.disconnect();
          delete container.dataset.flipReady;
        },
      });
    });

    if (!dialogObserver) {
      dialogObserver = new MutationObserver(refreshFlipCards);
      dialogObserver.observe(document.body, { attributes: true, subtree: true, attributeFilter: ["open"] });
    }
  }

  initFlipCards();
  document.addEventListener("astro:page-load", initFlipCards);
  document.addEventListener("visibilitychange", refreshFlipCards);
  reducedMotion.addEventListener("change", refreshFlipCards);
  window.addEventListener("pagehide", () => {
    pageHidden = true;
    refreshFlipCards();
  });
  window.addEventListener("pageshow", () => {
    pageHidden = false;
    initFlipCards();
    refreshFlipCards();
  });
  document.addEventListener("astro:before-swap", () => {
    controllers.forEach(({ destroy }) => destroy());
    controllers.clear();
    dialogObserver?.disconnect();
    dialogObserver = undefined;
  });
</script>

<style>
  .flip-card-content {
    flex: 1;
    min-width: 0;
    min-height: 0;
  }
  .flip-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: none;
    gap: 8px;
    min-height: 24px;
    margin-top: 12px;
    font-family: sans-serif;
    font-size: 10px;
    line-height: 1.3;
  }
  .flip-card-footer-note {
    min-width: 0;
  }
  .flip-card-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex: none;
    margin-left: auto;
    padding: 5px 4px;
    border-radius: 4px;
    cursor: pointer;
  }
  .flip-card-toggle:hover { color: #fff; }
  .flip-card-toggle:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 2px;
  }
  .flip-card-toggle[hidden] { display: none; }
  .flip-card-surface-toggle {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: transparent;
    cursor: pointer;
  }
  .flip-card-surface-toggle:focus-visible {
    outline: 2px solid #99f6e4;
    outline-offset: -5px;
  }
  .flip-card-compact .flip-card-footer {
    margin-top: 4px;
    min-height: 20px;
  }
  .flip-card-compact .flip-card-toggle { padding-block: 3px; }
  .flip-card-edge .flip-card-footer { margin: 8px 16px 12px; }
  .perspective-1000 {
    perspective: 1000px;
  }
  .transform-style-3d {
    transform-style: preserve-3d;
  }
  .backface-hidden {
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }
  .rotate-y-180 {
    transform: rotateY(180deg);
  }
  .flip-card-inner.flipped {
    transform: rotateY(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .flip-card-inner { transition: none; }
  }
</style>
