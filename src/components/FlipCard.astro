---
interface Props {
  colSpan?: string;
  rowSpan?: string;
  href?: string;
  padding?: string;
  color?: string;
  borderColor?: string;
  class?: string;
  label?: string;
  frontLabel?: string;
  backLabel?: string;
  toggleColor?: string;
  compact?: boolean;
  hideFrontToggle?: boolean;
  customControls?: boolean;
  hoverFlip?: boolean;
}

const {
  colSpan, rowSpan, padding = "p-6", color = "bg-darkslate-500",
  borderColor = "border-darkslate-100", class: className,
  label = "Card", frontLabel = "Details", backLabel = "Overview",
  toggleColor = "text-gray-400", compact = false, hideFrontToggle = false,
  customControls = false, hoverFlip = true,
} = Astro.props;
---

<!-- Grid stretch fills desktop rows; a global h-full would override mobile heights. -->
<div data-flip-card data-flip-hover={String(hoverFlip)} data-manual-face="front" class:list={[
  `flip-card-container group perspective-1000 w-full ${colSpan || "md:col-span-1"} ${rowSpan || "md:row-span-1"} ${className || "min-h-[180px] lg:min-h-0"}`,
  { "flip-card-compact": compact, "flip-card-edge": padding === "p-0" },
]}>
  <div data-flip-inner class="flip-card-inner relative w-full h-full transition-transform duration-700 transform-style-3d">
    <div data-flip-side="front" aria-hidden="false" class={`flip-card-front absolute inset-0 backface-hidden ${color} shadow-lg rounded-lg ${padding} border ${borderColor} flex flex-col overflow-hidden`}>
      <div class="flip-card-content"><slot name="front" /></div>
      {!customControls && (!hideFrontToggle || Astro.slots.has("footer-front")) && (
        <div class="flip-card-footer">
          <div class="flip-card-footer-note"><slot name="footer-front" /></div>
          {!hideFrontToggle && <button type="button" data-flip-to="back" class={`flip-card-toggle ${toggleColor}`} aria-label={`${label}: ${frontLabel}`} title={frontLabel} hidden>
            <span aria-hidden="true">↻</span>
          </button>}
        </div>
      )}
      {!customControls && hideFrontToggle && <button type="button" data-flip-to="back" class="flip-card-surface-toggle" aria-label={`${label}: ${frontLabel}`} hidden></button>}
    </div>

    <div data-flip-side="back" aria-hidden="true" inert class={`flip-card-back absolute inset-0 backface-hidden rotate-y-180 ${color} shadow-lg rounded-lg ${padding} border ${borderColor} flex flex-col overflow-hidden`}>
      <div class="flip-card-content"><slot name="back" /></div>
      {!customControls && <div class="flip-card-footer">
        <div class="flip-card-footer-note"><slot name="footer-back" /></div>
        <button type="button" data-flip-to="front" class={`flip-card-toggle ${toggleColor}`} aria-label={`${label}: ${backLabel}`} title={backLabel} hidden>
          <span aria-hidden="true">↻</span>
        </button>
      </div>}
    </div>
  </div>
</div>

<script>
  import "../lib/flip-cards";
</script>

<style>
  .flip-card-content {
    flex: 1;
    min-width: 0;
    min-height: 0;
  }
  .flip-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex: none;
    gap: 8px;
    min-height: 24px;
    margin-top: 12px;
    font-family: sans-serif;
    font-size: 10px;
    line-height: 1.3;
  }
  .flip-card-footer-note {
    min-width: 0;
  }
  .flip-card-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    flex: none;
    margin-left: auto;
    min-width: 24px;
    padding: 5px 4px;
    border-radius: 4px;
    cursor: pointer;
  }
  .flip-card-toggle span { font-size: 14px; line-height: 1; }
  .flip-card-toggle:hover { color: #fff; }
  .flip-card-toggle:focus-visible {
    outline: 1px solid currentColor;
    outline-offset: 2px;
  }
  .flip-card-toggle[hidden] { display: none; }
  .flip-card-surface-toggle {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: transparent;
    cursor: pointer;
  }
  .flip-card-surface-toggle:focus-visible {
    outline: 2px solid #99f6e4;
    outline-offset: -5px;
  }
  .flip-card-compact .flip-card-footer {
    margin-top: 4px;
    min-height: 20px;
  }
  .flip-card-compact .flip-card-toggle { padding-block: 3px; }
  .flip-card-edge .flip-card-footer { margin: 8px 16px 12px; }
  .perspective-1000 {
    perspective: 1000px;
  }
  .transform-style-3d {
    transform-style: preserve-3d;
  }
  .backface-hidden {
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }
  .rotate-y-180 {
    transform: rotateY(180deg);
  }
  .flip-card-inner.flipped {
    transform: rotateY(180deg);
  }
  @media (prefers-reduced-motion: reduce) {
    .flip-card-inner { transition: none; }
  }
</style>
