---
interface Props {
  titleId: string;
}

const { titleId } = Astro.props;

// Restored from the original Recent Work card (92b54af).
const paper = {
  title: "From narrative to action: A hierarchical cognitive large language model agent framework for interpretable and adaptive human mobility behavior generation",
  journal: "Engineering Applications of Artificial Intelligence",
  doi: "10.1016/j.engappai.2026.116203",
  href: "https://www.sciencedirect.com/science/article/pii/S0952197626024875",
};
---

<div class="recent-work">
  <header class="recent-work-heading">
    <h2 id={titleId}>Recent work</h2>
    <slot name="actions" />
  </header>
  <article>
    <h3><a href={paper.href} target="_blank" rel="noopener noreferrer">{paper.title}</a></h3>
    <p class="paper-authors">Qiumeng Li, <strong>Chunhou Ji</strong>, Xinyue Liu</p>
    <p class="paper-meta">{paper.journal} · 184 (2026), 116203</p>
  </article>
  <a class="paper-doi" href={`https://doi.org/${paper.doi}`} target="_blank" rel="noopener noreferrer">DOI: {paper.doi} <span aria-hidden="true">↗</span></a>
</div>

<style>
  .recent-work { display: flex; flex: 1; flex-direction: column; justify-content: space-between; gap: 16px; min-width: 0; }
  .recent-work-heading { display: flex; flex: none; align-items: center; justify-content: space-between; gap: 12px; }
  h2 { margin: 0; color: #f5f5f5; font: 700 20px/1.3 "JetBrains Mono", monospace; }
  article { display: grid; gap: 9px; }
  h3 { margin: 0; color: #e5f2ee; font: 500 18px/1.4 "Satoshi", sans-serif; }
  a { color: inherit; text-decoration: none; }
  a:hover { color: #00e5d4; }
  a:focus-visible { outline: 1px solid #00e5d4; outline-offset: 4px; border-radius: 2px; }
  p { margin: 0; font-family: "Satoshi", sans-serif; }
  .paper-authors { color: #a7b8b3; font-size: 13px; line-height: 1.4; }
  .paper-authors strong { color: #e5f2ee; font-weight: 600; }
  .paper-meta { color: #9ba9a7; font-size: 12px; line-height: 1.5; }
  .paper-doi { align-self: flex-start; color: #9ba9a7; font-size: 11px; line-height: 1.5; overflow-wrap: anywhere; }
  @container token-usage (max-width: 560px) {
    h3 { font-size: 17px; }
  }
</style>
