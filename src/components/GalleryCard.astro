---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";
import { Icon } from "astro-icon/components";
import photoDetails from "../data/gallery.json";

// Numbered filenames determine the playback order; new images are included automatically.
const images = import.meta.glob<{ default: ImageMetadata }>("../assets/gallery/*.{jpg,jpeg,png,webp,avif,JPG,JPEG,PNG,WEBP,AVIF}", { eager: true });
const details: Record<string, { alt: string; position?: string }> = photoDetails;
const photos = Object.entries(images)
  // Keep landscape and near-square crops (within 10% of square), skipping portrait photos.
  .filter(([, { default: image }]) => image.width >= image.height * 0.9)
  .sort(([a], [b]) => a.localeCompare(b, "en", { numeric: true }))
  .map(([path, module], index) => {
    const detail = details[path.split("/").pop()!];
    return {
      id: `gallery-photo-${index + 1}`,
      image: module.default,
      alt: detail?.alt ?? `Gallery photo ${index + 1}`,
      position: detail?.position ?? "50% 50%",
    };
  });
---

<section class="gallery-card" data-gallery-carousel role="region" aria-roledescription="carousel" aria-labelledby="gallery-title">
  <header class="gallery-header">
    <h2 id="gallery-title">Gallery</h2>
    <span data-gallery-counter>{photos.length ? "01" : "00"} / {String(photos.length).padStart(2, "0")}</span>
  </header>
  <div class="gallery-stage">
    <div class="gallery-frame">
      {photos.map((photo, index) => (
        <a href={photo.image.src} class="gallery-slide" data-gallery-slide data-active={index === 0 ? "true" : "false"} data-gallery-open={photo.id} aria-hidden={index !== 0} inert={index !== 0} aria-label={`View photo ${index + 1}: ${photo.alt}`} title="View photo">
          <Image src={photo.image} alt={photo.alt} width={960} widths={[320, 640, 960]} sizes="(min-width: 1024px) 238px, (min-width: 700px) 45vw, 90vw" quality={85} style={`object-position: ${photo.position}`} loading="lazy" />
        </a>
      ))}
    </div>
  </div>
  <footer class="gallery-footer">
    <div class="gallery-controls" hidden>
      <button type="button" data-gallery-previous aria-label="Previous photo" title="Previous photo"><Icon name="ri:arrow-left-s-line" aria-hidden="true" /></button>
      <button type="button" class="gallery-playback" data-gallery-playback aria-label="Pause slideshow" title="Pause slideshow">
        <span data-gallery-pause aria-hidden="true"><Icon name="ri:pause-fill" /></span>
        <span data-gallery-play aria-hidden="true" hidden><Icon name="ri:play-fill" /></span>
      </button>
      <button type="button" data-gallery-next aria-label="Next photo" title="Next photo"><Icon name="ri:arrow-right-s-line" aria-hidden="true" /></button>
    </div>
  </footer>
</section>

{photos.map((photo) => (
  <dialog id={photo.id} class="gallery-dialog" aria-label={photo.alt}>
    <button class="gallery-close" type="button" data-gallery-close aria-label="Close photo" title="Close photo">×</button>
    <figure>
      <img src={photo.image.src} width={photo.image.width} height={photo.image.height} alt={photo.alt} loading="lazy" />
    </figure>
  </dialog>
))}

<script>
  const galleries = new Map<HTMLElement, () => void>();

  const initGallery = () => {
    document.querySelectorAll<HTMLElement>("[data-gallery-carousel]").forEach((card) => {
      if (galleries.has(card)) return;
      const slides = [...card.querySelectorAll<HTMLAnchorElement>("[data-gallery-slide]")];
      const playback = card.querySelector<HTMLButtonElement>("[data-gallery-playback]");
      const counter = card.querySelector<HTMLElement>("[data-gallery-counter]");
      const controls = card.querySelector<HTMLElement>(".gallery-controls");
      if (slides.length < 2 || !playback || !counter || !controls) return;

      const events = new AbortController();
      const motion = window.matchMedia("(prefers-reduced-motion: reduce)");
      let index = 0;
      let paused = motion.matches;
      let inView = false;
      let hovered = card.matches(":hover");
      let timer: number | undefined;
      controls.hidden = false;

      const show = (next: number) => {
        index = (next + slides.length) % slides.length;
        slides.forEach((slide, i) => {
          const active = i === index;
          slide.dataset.active = String(active);
          slide.inert = !active;
          slide.setAttribute("aria-hidden", String(!active));
        });
        counter.textContent = `${String(index + 1).padStart(2, "0")} / ${String(slides.length).padStart(2, "0")}`;
      };

      const refresh = () => {
        window.clearTimeout(timer);
        const focused = document.activeElement;
        const readingWithKeyboard = focused instanceof Element && card.contains(focused) && focused.matches(":focus-visible") && focused !== playback;
        if (paused || hovered || !inView || document.hidden || readingWithKeyboard || document.querySelector("dialog[open]")) return;
        timer = window.setTimeout(() => { show(index + 1); refresh(); }, 5000);
      };

      const updatePlayback = () => {
        playback.setAttribute("aria-label", paused ? "Play slideshow" : "Pause slideshow");
        playback.title = paused ? "Play slideshow" : "Pause slideshow";
        playback.querySelector<HTMLElement>("[data-gallery-pause]")!.hidden = paused;
        playback.querySelector<HTMLElement>("[data-gallery-play]")!.hidden = !paused;
        refresh();
      };

      card.querySelector("[data-gallery-previous]")?.addEventListener("click", () => { show(index - 1); refresh(); }, { signal: events.signal });
      card.querySelector("[data-gallery-next]")?.addEventListener("click", () => { show(index + 1); refresh(); }, { signal: events.signal });
      playback.addEventListener("click", () => { paused = !paused; updatePlayback(); }, { signal: events.signal });
      card.addEventListener("pointerenter", (event) => {
        if (event.pointerType !== "touch") { hovered = true; refresh(); }
      }, { signal: events.signal });
      card.addEventListener("pointerleave", (event) => {
        if (event.pointerType !== "touch") { hovered = false; refresh(); }
      }, { signal: events.signal });
      card.addEventListener("focusin", refresh, { signal: events.signal });
      card.addEventListener("focusout", () => queueMicrotask(refresh), { signal: events.signal });
      document.addEventListener("visibilitychange", refresh, { signal: events.signal });
      motion.addEventListener("change", () => { paused = motion.matches; updatePlayback(); }, { signal: events.signal });
      const visibility = new IntersectionObserver(([entry]) => { inView = entry.isIntersecting; refresh(); });
      visibility.observe(card);
      const dialogs = new MutationObserver(refresh);
      dialogs.observe(document.body, { attributes: true, subtree: true, attributeFilter: ["open"] });
      updatePlayback();
      galleries.set(card, () => {
        window.clearTimeout(timer);
        events.abort();
        visibility.disconnect();
        dialogs.disconnect();
      });
    });

    document.querySelectorAll<HTMLAnchorElement>("[data-gallery-open]").forEach((link) => {
      if (link.dataset.galleryReady) return;
      const dialog = document.getElementById(link.dataset.galleryOpen ?? "");
      if (!(dialog instanceof HTMLDialogElement)) return;
      link.dataset.galleryReady = "true";
      link.addEventListener("click", (event) => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        dialog.showModal();
      });
      dialog.querySelector("[data-gallery-close]")?.addEventListener("click", () => dialog.close());
      dialog.addEventListener("click", (event) => {
        if (event.target !== dialog) return;
        const bounds = dialog.getBoundingClientRect();
        if (event.clientX < bounds.left || event.clientX > bounds.right || event.clientY < bounds.top || event.clientY > bounds.bottom) dialog.close();
      });
    });
  };
  initGallery();
  document.addEventListener("astro:page-load", initGallery);
  document.addEventListener("astro:before-swap", () => { galleries.forEach((dispose) => dispose()); galleries.clear(); });
</script>

<style>
  .gallery-card { display: flex; flex-direction: column; gap: 10px; min-width: 0; padding: 16px; border: 1px solid #426071; border-radius: 8px; background: #050505; }
  .gallery-header { display: flex; flex: none; align-items: center; justify-content: space-between; gap: 8px; }
  .gallery-header h2 { margin: 0; color: #a5c5d8; font-size: 11px; font-weight: 700; line-height: 1.5; }
  .gallery-header > span { color: #617580; font-size: 9px; line-height: 1.5; }
  .gallery-stage { display: grid; place-items: center; flex: 1; min-height: 0; }
  .gallery-frame { position: relative; width: 100%; max-height: 100%; aspect-ratio: 3 / 2; border-radius: 3px; background: #0d151b; }
  .gallery-slide { position: absolute; inset: 0; display: block; border-radius: inherit; opacity: 0; pointer-events: none; transition: opacity 700ms ease; }
  .gallery-slide[data-active="true"] { opacity: 1; pointer-events: auto; z-index: 1; }
  .gallery-slide :global(img) { display: block; width: 100%; height: 100%; border-radius: inherit; object-fit: cover; filter: saturate(.6) brightness(.85); }
  .gallery-footer { display: flex; align-items: center; justify-content: flex-end; gap: 4px; min-height: 24px; }
  .gallery-controls { display: flex; flex: none; align-items: center; }
  .gallery-controls[hidden], .gallery-playback span[hidden] { display: none; }
  .gallery-controls button { display: grid; place-items: center; width: 24px; height: 24px; padding: 0; border: 0; background: transparent; color: #8aa2b0; cursor: pointer; }
  .gallery-controls :global(svg) { display: block; width: 15px; height: 15px; }
  .gallery-playback :global(svg) { display: block; width: 13px; height: 13px; }
  .gallery-controls button:hover { color: #e3f2fa; }
  @media (prefers-reduced-motion: reduce) { .gallery-slide { transition: none; } }
  .gallery-dialog { position: fixed; inset: 0; width: min(920px, calc(100vw - 32px)); max-height: calc(100svh - 32px); margin: auto; padding: 16px; overflow: auto; color: #dbe5ea; background: #090d10; border: 1px solid #426071; border-radius: 8px; }
  .gallery-dialog::backdrop { background: #000d; backdrop-filter: blur(6px); }
  .gallery-close { display: grid; place-items: center; width: 32px; height: 32px; margin: 0 0 8px auto; border: 0; background: transparent; color: #b6ccd8; font-size: 24px; cursor: pointer; }
  figure { margin: 0; }
  figure img { display: block; width: 100%; height: auto; max-height: calc(100svh - 108px); object-fit: contain; }
  a:focus-visible, button:focus-visible { outline: 1px solid #a5c5d8; outline-offset: 3px; }
</style>
