---
import { formatPetWeight, getDailyWeightChart, type PetWeightData } from "../lib/pet-weight";

interface Props {
  catName: string;
  data: PetWeightData;
}

const { catName, data } = Astro.props;
const { reportedOn, summary, daily } = data;
const history = getDailyWeightChart(daily);
const latest = history ? data.latestMeasurement ?? history.latest : null;
const weight = latest ? formatPetWeight(latest.kg) : summary.kind === "stable"
  ? formatPetWeight(summary.current)
  : `${formatPetWeight(summary.min)}–${formatPetWeight(summary.max)}`;
const status = summary.kind === "stable"
  ? "Current weight; broadly stable over the preceding month, with subtle illustrative random variations in the curve."
  : "Reported fluctuation range; curve shows small illustrative random variations.";
const aggregation = data.aggregation === "daily-median" ? "Daily medians of accepted readings" : "Recorded measurements";
const source = data.source === "P7" ? "P7 data; cat identity is inferred from weight. " : "";
const description = history && latest
  ? `${catName}: latest ${latest.kg} kg, measured ${latest.date}. ${source}${aggregation}, ${history.points[0].date} to ${history.latest.date}. Dates without records are omitted.`
  : `${catName}: ${weight} kg. ${status} Reported ${reportedOn}. Schematic summary, not individual dated measurements.`;

// Keep the illustrative fluctuations consistent between builds and visits.
let seed = Array.from(`${catName}-${reportedOn}`).reduce(
  (value, character) => Math.imul(value ^ character.charCodeAt(0), 16777619), 2166136261,
) >>> 0;
const count = 9;
const amplitude = summary.kind === "stable" ? 6 : 14;
const points = Array.from({ length: count }, (_, index) => {
  seed = (Math.imul(seed, 1664525) + 1013904223) >>> 0;
  return { x: 4 + index / (count - 1) * 152, y: 25 + (seed / 4294967296 - 0.5) * amplitude };
});
const curve = points.map((point, index) => {
  if (index === 0) return `M${point.x},${point.y}`;
  const previous = points[index - 1];
  const middle = (previous.x + point.x) / 2;
  return `C${middle},${previous.y} ${middle},${point.y} ${point.x},${point.y}`;
}).join(" ");
const endpoint = points[points.length - 1];
const displayCurve = history ? history.curve : curve;
const displayFill = history ? history.fill : `${curve} L156,48 L4,48 Z`;
---

<figure class="cat-weight" data-weight-mode={history ? "daily" : "illustrative"}>
  <div class="weight-heading">
    <span title={description}>Weight</span>
    <strong>{weight}<small> kg</small></strong>
  </div>
  <svg width="160" height="50" viewBox="0 0 160 50" preserveAspectRatio="none" role="img" aria-label={description}>
    <title>{description}</title>
    <path class="weight-grid" d="M4 18H156M4 38H156" />
    {displayFill && <path class="weight-fill" d={displayFill} />}
    <path class="weight-line" d={displayCurve} />
    {history ? history.points.map((point, index) => (
      <circle class="weight-point" cx={point.x} cy={point.y} r={index === history.points.length - 1 ? 2.5 : 1.5}>
        <title>{point.date}: {point.kg} kg{data.aggregation === "daily-median" ? `, median of ${point.samples} accepted readings` : ""}</title>
      </circle>
    )) : <circle class="weight-point" cx={endpoint.x} cy={endpoint.y} r="2.5" />}
  </svg>
</figure>

<style>
  .cat-weight { display: flex; flex-direction: column; gap: 4px; min-width: 0; margin: 0; }
  .weight-heading { display: flex; align-items: baseline; justify-content: space-between; gap: 6px; }
  .weight-heading > span { color: #aa939e; font-size: 9px; line-height: 1.5; }
  strong { color: #f2e8ed; font-size: 11px; font-weight: 500; line-height: 1.5; white-space: nowrap; }
  small { color: #aa939e; font-size: 9px; font-weight: 400; }
  svg { display: block; width: 100%; height: 34px; overflow: visible; }
  .weight-grid { fill: none; stroke: #d7a7bb18; stroke-width: 1; vector-effect: non-scaling-stroke; }
  .weight-fill { fill: #d7a7bb0c; }
  .weight-line { fill: none; stroke: #d7a7bb; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; vector-effect: non-scaling-stroke; }
  .weight-point { fill: #050505; stroke: #ebc2d3; stroke-width: 1.5; vector-effect: non-scaling-stroke; }
</style>
