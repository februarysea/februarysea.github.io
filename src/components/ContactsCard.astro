---
import { LINKS } from "../lib/constants";
import FlipCard from "./FlipCard.astro";
import { Icon } from "astro-icon/components";
---

<FlipCard label="Contact" frontLabel="Contact details" backLabel="Connect" toggleColor="text-purple-300" color="bg-[#050505]" borderColor="border-purple-500" class="contact-card">
  <div slot="front" class="h-full flex flex-col justify-between">
    <header class="flex items-center">
      <h2 class="text-white text-xl font-bold font-sans">Let's Connect!</h2>
    </header>
    <div class="flex flex-col justify-center items-center h-full gap-4">
      <p class="text-sm text-gray-300 text-center font-sans">Open to research collaborations and technical discussions.</p>
      <div class="flex gap-4">
        <a href={LINKS.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <Icon name="ri:github-fill" class="h-10 w-10 text-gray-300 hover:text-white transition-colors" />
        </a>
        <a href={LINKS.x} target="_blank" rel="noopener noreferrer" aria-label="X: @SeaFebruary">
          <Icon name="ri:twitter-x-fill" class="h-10 w-10 text-gray-300 hover:text-white transition-colors" />
        </a>
        <a href={`mailto:${LINKS.email}`} aria-label="Email">
          <Icon name="ri:mail-fill" class="h-10 w-10 text-gray-300 hover:text-white transition-colors" />
        </a>
      </div>
    </div>
  </div>
  <div slot="back" class="contact-details h-full flex flex-col">
    <h2 class="text-white text-xl font-bold font-sans">Contact Info</h2>
    <div class="contact-list flex flex-col w-full min-w-0">
      <div class="flex flex-col">
        <span class="text-xs text-gray-500 font-sans">Email</span>
        <a href={`mailto:${LINKS.email}`} class="contact-address text-white hover:text-primary-500" title={LINKS.email}>{LINKS.email}</a>
      </div>
      <div class="flex flex-col">
        <span class="text-xs text-gray-500 font-sans">GitHub</span>
        <a href={LINKS.github} target="_blank" rel="noopener noreferrer" class="contact-address text-white hover:text-primary-500" title={LINKS.github}>@{LINKS.github.split("/").filter(Boolean).at(-1)}</a>
      </div>
      <div class="flex flex-col">
        <span class="text-xs text-gray-500 font-sans">X</span>
        <a href={LINKS.x} target="_blank" rel="noopener noreferrer" class="contact-address text-white hover:text-primary-500" title={LINKS.x}>@{LINKS.x.split("/").filter(Boolean).at(-1)}</a>
      </div>
    </div>
    <p class="contact-note">Research ideas welcome.</p>
  </div>
</FlipCard>

<style>
  :global(.portfolio-home .contact-card) { min-height: 300px; }
  .contact-details { min-width: 0; gap: 6px; }
  .contact-list { gap: 6px; }
  .contact-note { margin: auto 0 0; color: #9ca3af; font-size: 11px; line-height: 1.4; }
  .contact-address { display: block; width: fit-content; max-width: 100%; white-space: nowrap; font: 12px/1.7 ui-monospace, SFMono-Regular, Menlo, monospace; }
  a:focus-visible { outline: 1px solid #d8b4fe; outline-offset: 4px; }
  @media (min-width: 1024px) {
    :global(.portfolio-home .contact-card) { min-height: 0; }
  }
</style>
