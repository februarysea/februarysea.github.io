---
import { LINKS } from "../lib/constants";
import FlipCard from "./FlipCard.astro";
import { Icon } from "astro-icon/components";
---

<FlipCard label="Contact" frontLabel="Contact details" backLabel="Connect" toggleColor="text-purple-300" color="bg-[#050505]" borderColor="border-purple-500" padding="p-3" class="contact-card" compact>
  <div slot="front" class="contact-front">
    <h2>Let's Connect!</h2>
    <div class="contact-intro">
      <p>Open to research collaborations and technical discussions.</p>
      <div class="contact-socials">
        <a href={LINKS.github} target="_blank" rel="noopener noreferrer" aria-label="GitHub">
          <Icon name="ri:github-fill" />
        </a>
        <a href={LINKS.x} target="_blank" rel="noopener noreferrer" aria-label="X: @SeaFebruary">
          <Icon name="ri:twitter-x-fill" />
        </a>
        <a href={`mailto:${LINKS.email}`} aria-label="Email">
          <Icon name="ri:mail-fill" />
        </a>
      </div>
    </div>
  </div>
  <div slot="back" class="contact-details">
    <h2>Contact Info</h2>
    <div class="contact-list">
      <div class="contact-row">
        <span>Email</span>
        <a href={`mailto:${LINKS.email}`} class="contact-address text-white hover:text-primary-500" title={LINKS.email}>{LINKS.email}</a>
      </div>
      <div class="contact-row">
        <span>GitHub</span>
        <a href={LINKS.github} target="_blank" rel="noopener noreferrer" class="contact-address text-white hover:text-primary-500" title={LINKS.github}>@{LINKS.github.split("/").filter(Boolean).at(-1)}</a>
      </div>
      <div class="contact-row">
        <span>X</span>
        <a href={LINKS.x} target="_blank" rel="noopener noreferrer" class="contact-address text-white hover:text-primary-500" title={LINKS.x}>@{LINKS.x.split("/").filter(Boolean).at(-1)}</a>
      </div>
    </div>
  </div>
</FlipCard>

<style>
  .contact-front, .contact-details { display: flex; flex-direction: column; height: 100%; min-width: 0; gap: 6px; }
  h2 { margin: 0; color: #f4effa; font-size: 12px; font-weight: 700; line-height: 1.5; }
  .contact-intro { display: flex; flex: 1; flex-direction: column; align-items: center; justify-content: center; gap: 8px; min-height: 0; }
  .contact-intro p { margin: 0; color: #b7afc2; font-size: 10px; line-height: 1.5; text-align: center; }
  .contact-socials { display: flex; gap: 20px; }
  .contact-socials a { display: grid; place-items: center; color: #d8d0e1; }
  .contact-socials :global(svg) { width: 25px; height: 25px; }
  .contact-socials a:hover { color: #fff; }
  .contact-list { display: flex; flex: 1; flex-direction: column; justify-content: center; min-width: 0; gap: 4px; }
  .contact-row { display: grid; grid-template-columns: 36px minmax(0, 1fr); align-items: baseline; gap: 6px; }
  .contact-row > span { color: #9d8eae; font-size: 9px; }
  .contact-address { display: block; width: fit-content; max-width: 100%; overflow-wrap: anywhere; font: 10px/1.6 ui-monospace, SFMono-Regular, Menlo, monospace; }
  a:focus-visible { outline: 1px solid #d8b4fe; outline-offset: 4px; }
  @media (pointer: coarse) {
    .contact-socials a { min-width: 36px; min-height: 36px; }
  }
</style>
