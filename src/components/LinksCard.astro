---
import FlipCard from "./FlipCard.astro";
import LinkOutbound from "./LinkOutbound.astro";

const friends = [
  { name: "Shiqi Wang", href: "https://shiqi-wang.com/" },
];
const organizations = [
  { name: "UMEP Lab", href: "https://umeplab.github.io/" },
  { name: "ABMind", href: "https://abmind.cc/" },
];
---

<FlipCard label="Links" color="bg-[#050505]" borderColor="border-[#946b43]" padding="p-0" class="links-card" customControls>
  <div slot="front" class="links-face">
    <h2>Friends</h2>
    <nav class="links-list" aria-label="Friends' websites">
      {friends.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.name} <span aria-hidden="true">↗</span></a>)}
    </nav>
    <div class="links-art"><LinkOutbound kind="friends" /></div>
    <button type="button" data-flip-to="back" aria-label="Show organizations" hidden>Organizations <span aria-hidden="true">↻</span></button>
  </div>
  <div slot="back" class="links-face">
    <h2>Organizations</h2>
    <nav class="links-list" aria-label="Organizations and communities">
      {organizations.map((link) => <a href={link.href} target="_blank" rel="noopener noreferrer">{link.name} <span aria-hidden="true">↗</span></a>)}
    </nav>
    <div class="links-art"><LinkOutbound kind="organizations" /></div>
    <button type="button" data-flip-to="front" aria-label="Show friends" hidden>Friends <span aria-hidden="true">↻</span></button>
  </div>
</FlipCard>

<style>
  .links-face { display: grid; grid-template-columns: minmax(0, 1fr) clamp(88px, 29%, 152px); grid-template-rows: auto minmax(0, 1fr) auto; grid-template-areas: "heading art" "links art" "toggle toggle"; gap: 4px 12px; height: 100%; padding: 10px 16px; min-width: 0; }
  h2 { grid-area: heading; margin: 0; color: #d6ad82; font-size: 11px; font-weight: 700; line-height: 1.5; }
  button { grid-area: toggle; display: inline-flex; justify-self: end; align-self: end; align-items: center; gap: 7px; padding: 3px 0 3px 5px; border: 0; border-radius: 3px; background: transparent; color: #d6ad82; font: inherit; font-size: 11px; line-height: 1.5; white-space: nowrap; cursor: pointer; }
  button[hidden] { display: none; }
  a { color: #eee5dd; font-size: 12px; line-height: 1.5; text-decoration: none; }
  a:hover, button:hover { color: #ffe0bd; }
  a:focus-visible, button:focus-visible { outline: 1px solid #daaa83; outline-offset: 3px; }
  .links-list { grid-area: links; display: flex; align-items: center; align-content: center; flex-wrap: wrap; gap: 4px 20px; min-height: 0; }
  .links-list a { white-space: nowrap; }
  .links-art { grid-area: art; position: relative; min-width: 0; min-height: 0; pointer-events: none; }
  a span { color: #b99064; }
  @media (max-width: 1023px) {
    .links-face { padding: 14px 16px; }
  }
  @media (pointer: coarse) {
    button, a { min-height: 36px; }
    a { display: inline-flex; align-items: center; gap: 6px; }
    .links-face { grid-template-rows: auto 1fr auto; }
  }
  @media (pointer: coarse) and (max-width: 1023px) {
    :global(.portfolio-home .links-card) { min-height: 164px; }
  }
</style>
