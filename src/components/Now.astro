---
import FlipCard from "./FlipCard.astro";
import Pulse from "./Pulse.astro";
---

<FlipCard label="Now" frontLabel="Current focus" backLabel="Now" toggleColor="text-rose-300" padding="p-6 lg:px-3 lg:py-1.5" compact colSpan="md:col-span-1" rowSpan="md:row-span-1" color="bg-[#050505]" borderColor="border-rose-500" class="h-[180px] lg:h-full">
  <div slot="front" class="now-face">
    <div class="now-heading-row">
      <div class="now-title-row">
        <h2 class="now-title">Now</h2>
        <a href="https://sive.rs/nowff" target="_blank" class="now-aside text-gray-500">
          what's that ?
        </a>
      </div>
      <Pulse />
    </div>
    <p class="now-copy">Pursuing PhD degree</p>
  </div>

  <div slot="back" class="now-face">
    <div class="now-heading-row">
      <h2 class="now-title text-primary-500 font-bold">Status</h2>
      <p class="now-aside">Busy but excited</p>
    </div>
    <p class="now-copy text-gray-300">Preparing projects and papers</p>
  </div>
</FlipCard>

<style>
  .now-face {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    width: 100%;
    height: 100%;
    font-family: sans-serif;
  }
  .now-heading-row, .now-title-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .now-heading-row { justify-content: space-between; }
  .now-title { font-size: 16px; line-height: 20px; }
  .now-aside, .now-copy { font-size: 12px; line-height: 16px; }
  @media (min-width: 1024px) {
    .now-face { justify-content: center; }
    .now-title { font-size: 14px; line-height: 14px; }
    .now-aside { font-size: 10px; line-height: 12px; }
    .now-copy { font-size: 11px; line-height: 13px; }
  }
</style>
