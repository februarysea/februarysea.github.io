---
import Layout from "../layouts/BasicLayout.astro";
import FlipCard from "../components/FlipCard.astro";
import IntroCard from "../components/IntroCard.astro";
import ContactsCard from "../components/ContactsCard.astro";
import UrbanCognitiveAgent from "../components/UrbanCognitiveAgent.astro";
import TrainingCard from "../components/TrainingCard.astro";
import Now from "../components/Now.astro";
import LinksCard from "../components/LinksCard.astro";

---

<Layout
  description="PhD Student at HKUST (GZ) specializing in Agent-Based Modeling, LLM Agents, and Urban Data Analysis."
  title="Chunhou Ji - PhD Student & Researcher"
>
  <main
    class="portfolio-home text-white m-auto p-2 grid gap-2 max-w-6xl overflow-hidden relative w-full sm:p-4 sm:gap-2 md:grid-cols-2 md:gap-3 md:p-6 lg:h-screen lg:grid-rows-8 lg:grid-cols-4 lg:gap-4 lg:max-h-[800px]"
  >
    <div class="md:col-span-2 lg:col-span-4 lg:row-span-4 grid gap-2 md:grid-cols-2 md:gap-3 lg:grid-cols-[3fr_2fr] lg:gap-4 min-h-0">
      <IntroCard />
      <TrainingCard />
    </div>
    <ContactsCard />
    <UrbanCognitiveAgent />
    <LinksCard />
    <Now />
    <FlipCard
      label="Be water"
      frontLabel="Read quote"
      backLabel="Be water"
      toggleColor="text-slate-300"
      colSpan="md:col-span-1"
      href="#"
      rowSpan="md:row-span-2"
      color="bg-[#050505]"
      borderColor="border-slate-500"
      class="be-water-card min-h-[180px] lg:min-h-0"
    >
      <div slot="front" class="flex flex-col justify-center items-center h-full">
        <h2 class="text-2xl font-bold font-serif italic">"Be water"</h2>
      </div>
      <div slot="back" class="w-full h-full flex flex-col justify-center items-center">
         <p class="text-center text-sm text-gray-400 font-serif italic">"Empty your mind, be formless, shapeless — like water."</p>
         <p class="text-center text-xs text-gray-500 mt-2">— Bruce Lee</p>
      </div>
    </FlipCard>
    <FlipCard label="Site credits" frontLabel="Site author" backLabel="Theme credits" padding="p-3" compact colSpan="md:col-span-1" rowSpan="md:row-span-1" color="bg-[#050505]" borderColor="border-gray-600" class="h-[180px] lg:h-full">
      <div slot="front" class="h-full flex flex-col justify-center items-center font-sans text-center">
        <p class="text-[10px] leading-3 text-gray-400">Theme based on <span class="font-bold text-white">Bento Portfolio</span></p>
        <p class="text-[10px] leading-4 text-gray-500">by <a href="https://github.com/Ladvace/astro-bento-portfolio" target="_blank" class="hover:text-primary-500 underline">Gianmarco Cavallo</a></p>
      </div>
      <div slot="back" class="h-full flex flex-col justify-center items-center">
        <p class="text-[10px] leading-3 text-gray-400 font-sans">Modified by</p>
        <p class="text-xs leading-4 text-white font-bold font-sans">Chunhou Ji</p>
      </div>
    </FlipCard>
  </main>
</Layout>

<style is:global>
  .portfolio-home,
  .portfolio-home :not(.be-water-card, .be-water-card *) {
    font-family: Menlo, Monaco, Consolas, "Liberation Mono", monospace !important;
  }
</style>
