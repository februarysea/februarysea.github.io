---
import { apiUsage } from "../lib/api-usage";
import { summarizeUsage, compactTokens, exactTokens } from "../lib/token-usage";
const codex = summarizeUsage();
const count = (value: number | null) => value === null ? "—" : compactTokens(value);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <title>Token usage — Chunhou Ji</title>
    <meta name="description" content="Codex token activity and OpenAI API token usage by model." />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body>
    <main>
      <header>
        <a href="/" class="home">← Back home</a>
        <p class="eyebrow">CODEX + OPENAI API</p>
        <h1>Token usage</h1>
        <p class="intro">Two sources, with their own coverage and update dates.</p>
      </header>

      <div class="sources">
        <section aria-labelledby="codex-title">
          <div class="source-heading"><h2 id="codex-title">Codex</h2><span class="badge">Account activity</span></div>
          <p class="total" title={exactTokens(codex.totalTokens)}>{count(codex.totalTokens)} <span>tokens</span></p>
          <dl>
            <div><dt>Last 7 days</dt><dd>{count(codex.periodTokens)}</dd></div>
            <div><dt>Through</dt><dd>{codex.dataThrough ?? "Awaiting data"}</dd></div>
          </dl>
          <p class="note">Historical combined accounts through Oct 24, 2026; primary account only from Oct 25.</p>
        </section>
        <section aria-labelledby="api-title">
          <div class="source-heading"><h2 id="api-title">OpenAI API</h2><span class="badge">{apiUsage.connected ? "Organization usage" : "Not connected yet"}</span></div>
          <p class="total" title={apiUsage.totalTokens === null ? "Awaiting API usage data" : exactTokens(apiUsage.totalTokens)}>{count(apiUsage.totalTokens)} <span>tokens</span></p>
          <dl>
            <div><dt>Last 7 days</dt><dd>{count(apiUsage.recentTokens)}</dd></div>
            <div><dt>Through · UTC</dt><dd>{apiUsage.throughDate ?? "Awaiting data"}</dd></div>
          </dl>
          <p class="note">{apiUsage.connected ? `Recorded from ${apiUsage.startDate}. UTC days; today’s counts may still increase.` : "API usage will appear after its first successful sync."}</p>
        </section>
      </div>

      <section class="breakdown" aria-labelledby="model-title">
        <div class="breakdown-heading"><div><p class="eyebrow">OPENAI API</p><h2 id="model-title">By model</h2></div><span class="badge">Input + output</span></div>
        {apiUsage.connected && apiUsage.models.length > 0 ? (
          <div class="table-scroll" tabindex="0" role="region" aria-label="API model usage, scroll horizontally on small screens">
            <table>
              <caption>{apiUsage.startDate} – {apiUsage.throughDate} · UTC</caption>
              <thead><tr><th scope="col">Model</th><th scope="col">Input</th><th scope="col">Cached input¹</th><th scope="col">Output</th><th scope="col">Total</th></tr></thead>
              <tbody>{apiUsage.models.map((model) => <tr>
                <th scope="row"><span>{model.model === "unclassified" ? "Unclassified" : model.model}</span><span class="model-bar" aria-hidden="true" style={`--share: ${model.totalTokens / Math.max(1, apiUsage.models[0].totalTokens) * 100}%`}></span></th>
                <td title={exactTokens(model.inputTokens)}>{count(model.inputTokens)}</td>
                <td title={exactTokens(model.cachedInputTokens)}>{count(model.cachedInputTokens)}</td>
                <td title={exactTokens(model.outputTokens)}>{count(model.outputTokens)}</td>
                <td class="model-total" title={exactTokens(model.totalTokens)}>{count(model.totalTokens)}</td>
              </tr>)}</tbody>
            </table>
          </div>
        ) : <p class="empty">{apiUsage.connected ? "No API tokens recorded in this period." : "Awaiting API data. Model totals are not available yet."}</p>}
        <p class="note">¹ Cached input is already included in input tokens and is counted once. Covers the OpenAI completions usage endpoint; image counts, audio duration, tool charges, and other billing units are not included.</p>
      </section>

      <section class="accounting" aria-labelledby="accounting-title">
        <h2 id="accounting-title">About the numbers</h2>
        <p>Codex account history currently provides daily totals without a complete model breakdown. Those tokens remain unclassified; no model shares are estimated.</p>
        <p>Codex and API totals are shown separately. Their histories and daily reporting boundaries differ. API usage inside a coding client belongs in the API source and should not be added again from local session logs.</p>
        <p>Each source keeps its last successful snapshot if a sync is unavailable. The dates above show the actual coverage, not the date you opened this page.</p>
      </section>
      <footer><a href="https://developers.openai.com/api/reference/resources/admin/subresources/organization/subresources/usage/methods/completions">OpenAI Usage API reference ↗</a></footer>
    </main>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; background: #080b0b; color: #e8f0ee; font-family: Menlo, Monaco, Consolas, monospace; -webkit-font-smoothing: antialiased; }
  main { max-width: 1080px; margin: 0 auto; padding: 42px 28px 64px; }
  a { color: #9dc2bb; text-decoration: none; }
  a:hover { color: #00e5d4; }
  a:focus-visible, .table-scroll:focus-visible { outline: 2px solid #00e5d4; outline-offset: 5px; }
  .home { display: inline-block; margin-bottom: 48px; font-size: 12px; }
  .eyebrow { color: #00e5d4; font-size: 10px; letter-spacing: .13em; margin: 0 0 12px; }
  h1 { font-size: clamp(30px, 5vw, 48px); font-weight: 500; letter-spacing: -.06em; margin: 0; }
  .intro { color: #91a6a0; font-size: 12px; line-height: 1.8; margin: 18px 0 30px; }
  .sources { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 18px; }
  .sources section, .breakdown { padding: 24px; border: 1px solid #29413b; border-radius: 8px; background: #0c1210; min-width: 0; }
  .source-heading, .breakdown-heading { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 12px; }
  h2 { font-size: 16px; font-weight: 500; margin: 0; }
  .badge { color: #92aaa2; font-size: 10px; }
  .total { font-size: 38px; font-weight: 500; letter-spacing: -.05em; margin: 28px 0; font-variant-numeric: tabular-nums; }
  .total span { color: #8ba79e; font-size: 12px; letter-spacing: 0; }
  dl { margin: 0; display: grid; gap: 12px; font-size: 11px; }
  dl div { display: flex; justify-content: space-between; gap: 12px; }
  dt { color: #91a6a0; } dd { margin: 0; }
  .note { color: #8fa69d; font-size: 10px; line-height: 1.9; margin: 22px 0 0; }
  .breakdown { margin: 24px 0; }
  .table-scroll { overflow-x: auto; margin-top: 22px; }
  table { width: 100%; border-collapse: collapse; font-size: 12px; }
  caption { text-align: left; color: #91a6a0; font-size: 10px; padding-bottom: 14px; }
  th, td { padding: 17px 12px; border-bottom: 1px solid #22362f; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; }
  th:first-child { text-align: left; padding-left: 0; min-width: 200px; }
  thead th { color: #91a6a0; font-size: 10px; font-weight: 400; }
  tbody th { font-weight: 400; }
  td:last-child, th:last-child { padding-right: 0; }
  .model-total { color: #8fffe4; }
  .model-bar { display: block; width: var(--share); height: 2px; background: #00e5d4; margin-top: 9px; opacity: .65; }
  .empty { color: #a7b9b2; font-size: 12px; line-height: 1.8; padding: 28px 0 12px; }
  .accounting { padding: 12px 0 0; max-width: 820px; }
  .accounting p { color: #91a6a0; font-size: 11px; line-height: 1.9; margin: 16px 0 0; }
  footer { margin-top: 30px; font-size: 10px; }
  @media (max-width: 700px) { main { padding: 28px 18px 40px; } .sources { grid-template-columns: 1fr; } .sources section, .breakdown { padding: 20px; } .home { margin-bottom: 36px; } }
</style>
